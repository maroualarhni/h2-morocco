# H2 Morocco — .gitignore

# ── Environnement Python ──────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Variables d'environnement & secrets ──────────────────────────────────────
.env
*.env
secrets.toml
.streamlit/secrets.toml

# ── Données & Outputs (trop volumineux pour Git) ─────────────────────────────
outputs/
H2Morocco222_Outputs/
H2Storage_Model_Outputs/
h2pipeline/
*.csv
*.xlsx
*.parquet
*.h5
*.hdf5

# ── Figures & rapports générés ───────────────────────────────────────────────
figures/
reports/
*.png
*.jpg
*.pdf

# ── Cache Streamlit ───────────────────────────────────────────────────────────
.streamlit/cache/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.spyproject/
.spyderproject/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
